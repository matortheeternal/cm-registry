{
  "name": "cm-registry",
  "version": "1.0.0",
  "description": "A registry for card magician extensions.",
  "license": "MIT",
  "author": "mator",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test --test-isolation=none test/*.test.js",
    "migrate": "node scripts/maintenance.js migrate",
    "backup": "node scripts/maintenance.js backup",
    "cleanup": "node scripts/maintenance.js cleanup",
    "client": "node scripts/client.js"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "http-message-sig": "^0.3.0",
    "semver": "^7.8.6",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  }
}
